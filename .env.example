# Local / production environment (optional)
# Copy to .env — never commit secrets.

PORT=3000
PUBLIC_ORIGIN=https://firostatus.com

# Opt-in alerting (configure Telegram and/or a generic webhook)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=https://example.com/hooks/firostatus

# Required for POST /api/alerts/test when the request is not from loopback
# ALERT_TOKEN=generate-a-long-random-string

# ALERT_COOLDOWN_MS=1800000
# ALERT_LAG_SPIKE=10

# Set to 1 when Node sits behind a reverse proxy (rate-limit operator checks by X-Forwarded-For)
# FIRO_TRUST_PROXY=1
