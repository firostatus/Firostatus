# Local / production environment (optional)
# Copy to .env — never commit secrets.

PORT=3000
PUBLIC_ORIGIN=https://firostatus.com

# Opt-in alerting (configure Telegram and/or a generic webhook)
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=https://example.com/hooks/firostatus

# Required for POST /api/alerts/test when the request is not from loopback
# ALERT_TOKEN=generate-a-long-random-string

# ALERT_COOLDOWN_MS=1800000
# ALERT_LAG_SPIKE=10

# Set to 1 when Node sits behind a reverse proxy (rate-limit operator checks by X-Forwarded-For)
# FIRO_TRUST_PROXY=1

# Optional local Firo Core RPC — NOT used on firostatus.com today (shared host
# cannot run a modern synced firod). Left here for a future host that already
# runs a node (e.g. tip-service infra). When unset, Ecosystem uses public
# explorer + fironames.com only and hides RPC-only fields.
# FIRO_RPC_URL=http://127.0.0.1:8888/
# FIRO_RPC_USER=
# FIRO_RPC_PASSWORD=

# Optional overrides (defaults hit public explorer + fironames.com)
# FIRO_NAMES_URL=https://explorer.firo.org/api/sparknames
# FIRO_EXPLORER_STATUS_URL=https://explorer.firo.org/insight-api-zcoin/status
# FIRONAMES_ORIGIN=https://fironames.com
